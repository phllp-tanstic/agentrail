.env
node_modules/
.scratch/

# Generated dedicated-wallet store — CONTAINS PRIVATE KEYS IN PLAINTEXT.
# Never commit. Losing this file loses access to any funds in those wallets.
.wallet-store.json
build/.wallet-store.json
*.wallet-store.json

# Migration/rotation backups of the wallet store. The pre-migration backup is
# PLAINTEXT PRIVATE KEYS; the pre-rotation backup is encrypted but under a key
# that may since have been exposed elsewhere. Both must never be committed —
# the pattern above (*.wallet-store.json) does NOT match these, since they
# have extra suffix after .json, which is exactly the gap that let them show
# as untracked instead of ignored. Never assume a glob covers a variant
# filename — verify with `git check-ignore -v` before trusting it, especially
# for anything holding key material.
*.wallet-store.json.*

# Trade log — a user's real trading history (addresses, sizes, fills, payouts).
# No key material, but it is per-user activity data and does not belong in git.
.trade-log/
build/.trade-log/
*.jsonl

# Accounts store — API-key HASHES (not the keys themselves, salted SHA-256,
# not reversible), but still not repo material: a leaked store lets someone
# confirm which session_ids exist even though it can't forge a working key.
# Covering the exact filename AND any future backup-variant suffix from day
# one this time — *.wallet-store.json's narrow match was a real gap found and
# fixed only after the fact; not repeating that mistake here.
.accounts-store.json
build/.accounts-store.json
*.accounts-store.json
*.accounts-store.json.*

# Risk ledger store — per-session spend/loss tracking, persisted across
# restarts. Not secret, but real per-user financial state; does not
# belong in git. Covering both the exact filename and any future
# backup-variant suffix from day one.
.risk-store.json
build/.risk-store.json
*.risk-store.json
*.risk-store.json.*
.risk-store.*.tmp
