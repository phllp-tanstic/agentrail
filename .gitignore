.env
node_modules/
.scratch/

# Generated dedicated-wallet store — CONTAINS PRIVATE KEYS IN PLAINTEXT.
# Never commit. Losing this file loses access to any funds in those wallets.
.wallet-store.json
build/.wallet-store.json
*.wallet-store.json

# Trade log — a user's real trading history (addresses, sizes, fills, payouts).
# No key material, but it is per-user activity data and does not belong in git.
.trade-log/
build/.trade-log/
*.jsonl
